# SQLite works out of the box; for PostgreSQL use the asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://billing:billing@localhost:5432/billing
DATABASE_URL=sqlite+aiosqlite:///./hosting_billing.db

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# When set, all endpoints except /health require the header "X-API-Key: <value>"
# API_KEY=change-me

# Create tables on startup (SQLite demos). Use `alembic upgrade head` for real databases.
AUTO_CREATE_TABLES=false
